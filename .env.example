# انسخ هذا الملف إلى .env محلياً، وأضف نفس المتغير في إعدادات الاستضافة.
# احصل على المفتاح من: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# اختياري — تحدده منصة الاستضافة تلقائياً في الغالب
# PORT=3000

# اختياري — سلسلة النماذج بالترتيب، مفصولة بفواصل. الافتراضي:
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemma-4-26b-a4b-it
